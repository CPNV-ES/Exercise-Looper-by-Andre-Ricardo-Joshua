# -----------------------------------------------------------------------------
# Environment Configuration Example
# -----------------------------------------------------------------------------
#
# This file is a template for the environment variables.
# To get started, copy this file to a new file named `.env` in the same directory.
# Then, fill in the correct values for your local setup.
#
# The `.env` file is ignored by Git, so your secrets are safe.
#
# Choose ONE of the database configurations below by uncommenting its section.
#

# --- SQLite Configuration (Default) ---
# This is the simplest setup and requires no external database server.
DB_CONNECTION=sqlite
DB_DATABASE=database/app.sqlite

# --- MySQL / MariaDB Configuration ---
#DB_CONNECTION=mysql
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_DATABASE=exercise_looper_db
#DB_USERNAME=root
#DB_PASSWORD=
#DB_CHARSET=utf8mb4