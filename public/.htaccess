<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect trailing slashes to non-slash versions (optional but good for SEO)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [L,R=301]

    # Handle Front Controller: send all requests to index.php if a file or directory doesn't exist
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>